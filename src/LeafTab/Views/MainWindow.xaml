<Window x:Class="LeafTab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LeafTab.Controls"
        Title="LeafTab"
        Width="1160"
        Height="740"
        MinWidth="720"
        MinHeight="460"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="MainWindowChrome"
                            CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,126,0,28"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ==================== LIQUID GLASS CONTEXT MENU & MENU ITEM STYLES ==================== -->
        <Style x:Key="LiquidGlassMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#140F172A" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiquidGlassMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="8,6.5,14,6.5" />
            <Setter Property="Margin" Value="4,1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBd"
                                Background="Transparent"
                                CornerRadius="6.5"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="CheckGlyph"
                                          Width="10.5" Height="8.5" Stretch="Uniform"
                                          Stroke="#007AFF" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          Data="M1,4.2 L3.8,7 L9.2,1" />
                                    <ContentPresenter x:Name="IconHost"
                                                      ContentSource="Icon"
                                                      Width="16" Height="16"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />
                                </Grid>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="5,0,14,0" />

                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#8492A6"
                                           FontSize="11.5"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#1A007AFF" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiquidGlassContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LiquidGlassMenuItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="8,4,10,12"
                                Background="#F8FCFDFF"
                                BorderBrush="#1C0F172A"
                                BorderThickness="1"
                                CornerRadius="10.5"
                                Padding="3,5">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.13" />
                            </Border.Effect>
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== FRAMELESS FLOATING LIQUID GLASS BUTTON STYLES ==================== -->
        <Style x:Key="GlassNavIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#140F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCE4EEFA" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1C0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassGhostCommandButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#160F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4E5EFFC" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#200F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassGhostIconCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassGhostCommandButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="GlassBreadcrumbSegmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="6.5,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="12.4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14007AFF" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24007AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== MINIMALIST ROUNDED CAPTION BUTTONS ==================== -->
        <Style x:Key="LiquidCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,7,2,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#A8FFFFFF" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#CCDFE8F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiquidCloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource LiquidCaptionButtonStyle}">
            <Setter Property="Margin" Value="2,7,9,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#FF3B30" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#E02E24" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrameBorder" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Cloud-Mist Liquid Glass Connected Arc Tab Bar -->
                <RowDefinition Height="40" />
                <!-- Row 1: Liquid Glass Navigation + Breadcrumb Pod + Search Pod -->
                <RowDefinition Height="44" />
                <!-- Row 2: Frameless Floating Command Bar (SF Dual-Tone Icons) -->
                <RowDefinition Height="42" />
                <!-- Row 3: Collapsible Bookmark Bar (Ctrl+Shift+B) -->
                <RowDefinition Height="Auto" />
                <!-- Row 4: Pure Opaque #FFFFFF Native IExplorerBrowser Canvas -->
                <RowDefinition Height="*" />
                <!-- Row 5: Cloud-Mist Liquid Glass Footer Status Bar -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: LIQUID GLASS CONNECTED ARC TAB BAR ==================== -->
            <Border x:Name="TabTitleBarSurface"
                    Grid.Row="0"
                    Panel.ZIndex="6"
                    Background="#96DEE8F5"
                    BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Frosted White Glass LeafTab Emblem -->
                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            Margin="11,4,2,0"
                            CornerRadius="8"
                            Background="#EEFFFFFF"
                            BorderBrush="#160F172A"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="LeafTab（一叶）">
                        <Path Width="13.5" Height="13.5" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22C55E" Offset="0.0" />
                                    <GradientStop Color="#15803D" Offset="1.0" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Border>

                    <!-- Adaptive Zero-Scrollbar Connected Tabs + [+] Button -->
                    <controls:TabBarTrackPanel Grid.Column="1" VerticalAlignment="Stretch">
                        <ItemsControl x:Name="TabsItemsControl"
                                      VerticalAlignment="Stretch"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                      PreviewMouseWheel="TabStrip_PreviewMouseWheel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AdaptiveTabStripPanel MaxTabWidth="192" MinTabWidth="48" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Panel.ZIndex" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="2" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="10" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Bottom" Height="34" Margin="0,6,0,0">
                                        <!-- Subtle right separator between inactive tabs -->
                                        <Rectangle x:Name="InactiveSeparator"
                                                   Width="1" Height="14"
                                                   Fill="#1F0F172A"
                                                   Margin="0,0,0,2"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />

                                        <!-- Outward Left Concave Fillet Curve (melts active tab into Row 1 sheet) -->
                                        <Path x:Name="LeftConcaveEar"
                                              Width="9" Height="9"
                                              Margin="-9,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Bottom"
                                              Fill="#E8FAFCFF"
                                              Visibility="Collapsed"
                                              IsHitTestVisible="False"
                                              Data="M0,9 A9,9 0 0 0 9,0 L9,9 Z" />

                                        <!-- Outward Right Concave Fillet Curve (melts active tab into Row 1 sheet) -->
                                        <Path x:Name="RightConcaveEar"
                                              Width="9" Height="9"
                                              Margin="0,0,-9,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Fill="#E8FAFCFF"
                                              Visibility="Collapsed"
                                              IsHitTestVisible="False"
                                              Data="M9,9 A9,9 0 0 1 0,0 L0,9 Z" />

                                        <Border x:Name="TabPill"
                                                Height="29"
                                                Margin="1,0,1,3"
                                                Padding="10,0,6,0"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="8.5"
                                                BorderThickness="1"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                AllowDrop="True"
                                                ToolTip="{Binding ToolTipText}"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                MouseLeftButtonDown="TabPill_MouseLeftButtonDown"
                                                MouseMove="TabPill_MouseMove"
                                                MouseLeftButtonUp="TabPill_MouseLeftButtonUp"
                                                MouseRightButtonUp="TabPill_MouseRightButtonUp"
                                                MouseUp="TabPill_MouseUp"
                                                DragEnter="TabPill_DragEnter"
                                                DragOver="TabPill_DragOver"
                                                DragLeave="TabPill_DragLeave"
                                                Drop="TabPill_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0"
                                                       Width="16"
                                                       Height="16"
                                                       Margin="0,0,7,0"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Source="{Binding Icon}" />

                                                <TextBlock x:Name="TabTitleText"
                                                           Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           VerticalAlignment="Center"
                                                           FontSize="12.2"
                                                           Foreground="#334155"
                                                           TextTrimming="CharacterEllipsis" />

                                                <Button x:Name="CloseTabBtn"
                                                        Grid.Column="2"
                                                        Width="20"
                                                        Height="20"
                                                        Margin="4,0,0,0"
                                                        Opacity="0.62"
                                                        VerticalAlignment="Center"
                                                        Tag="{Binding}"
                                                        ToolTip="关闭标签页 (Ctrl+W)"
                                                        Focusable="False"
                                                        Click="CloseTabButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CloseBd" Background="Transparent" CornerRadius="5">
                                                                <Path x:Name="CloseGlyph"
                                                                      Width="7.5" Height="7.5" Stretch="Uniform"
                                                                      Stroke="#475569" StrokeThickness="1.3"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Data="M0.5,0.5 L7.5,7.5 M7.5,0.5 L0.5,7.5" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CloseBd" Property="Background" Value="#160F172A" />
                                                                    <Setter TargetName="CloseGlyph" Property="Stroke" Value="#0F172A" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <!-- Active Connected Arc Tab seamlessly fused into Row 1 (#E8FAFCFF) -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TabPill" Property="Height" Value="33" />
                                            <Setter TargetName="TabPill" Property="Margin" Value="0" />
                                            <Setter TargetName="TabPill" Property="CornerRadius" Value="10.5,10.5,0,0" />
                                            <Setter TargetName="TabPill" Property="BorderThickness" Value="1,1,1,0" />
                                            <Setter TargetName="TabPill" Property="Background" Value="#E8FAFCFF" />
                                            <Setter TargetName="TabPill" Property="BorderBrush" Value="#E6FFFFFF" />
                                            <Setter TargetName="LeftConcaveEar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="RightConcaveEar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="TabTitleText" Property="Foreground" Value="#0F172A" />
                                            <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="CloseTabBtn" Property="Opacity" Value="0.88" />
                                            <Setter TargetName="InactiveSeparator" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>

                                        <!-- Inactive Tab Soft Glass Pill Hover -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TabPill" Property="Background" Value="#8AFFFFFF" />
                                            <Setter TargetName="TabPill" Property="BorderBrush" Value="#B0FFFFFF" />
                                            <Setter TargetName="TabTitleText" Property="Foreground" Value="#0F172A" />
                                            <Setter TargetName="CloseTabBtn" Property="Opacity" Value="0.85" />
                                            <Setter TargetName="InactiveSeparator" Property="Visibility" Value="Hidden" />
                                        </MultiDataTrigger>

                                        <!-- Cross-Tab File Drag Hover Highlight -->
                                        <DataTrigger Binding="{Binding IsDragHoverTarget}" Value="True">
                                            <Setter TargetName="TabPill" Property="Background" Value="#DCEBFAFF" />
                                            <Setter TargetName="TabPill" Property="BorderBrush" Value="#007AFF" />
                                            <Setter TargetName="TabTitleText" Property="Foreground" Value="#0062CC" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- [+] New Tab Button hugging the last tab -->
                        <Button x:Name="NewTabButton"
                                Width="28"
                                Height="28"
                                Margin="0,6,0,3"
                                VerticalAlignment="Bottom"
                                ToolTip="新建标签页 (Ctrl+T)"
                                Style="{StaticResource GlassNavIconButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="NewTabButton_Click">
                            <Path Width="11" Height="11" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.45"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5.5,0.6 V10.4 M0.6,5.5 H10.4" />
                        </Button>
                    </controls:TabBarTrackPanel>

                    <!-- Top-Right Minimalist Rounded Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource LiquidCaptionButtonStyle}"
                                ToolTip="最小化"
                                Click="MinimizeButton_Click">
                            <Path Width="9.5" Height="2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M0.5,1 H9" />
                        </Button>
                        <Button x:Name="MaxRestoreButton"
                                Style="{StaticResource LiquidCaptionButtonStyle}"
                                ToolTip="最大化"
                                Click="MaxRestoreButton_Click">
                            <Path x:Name="MaxRestoreGlyph"
                                  Width="9.5" Height="9.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  StrokeLineJoin="Round"
                                  Data="M1.5,0.6 H8 A0.9,0.9 0 0 1 8.9,1.5 V8 A0.9,0.9 0 0 1 8,8.9 H1.5 A0.9,0.9 0 0 1 0.6,8 V1.5 A0.9,0.9 0 0 1 1.5,0.6 Z" />
                        </Button>
                        <Button Style="{StaticResource LiquidCloseCaptionButtonStyle}"
                                ToolTip="关闭"
                                Click="CloseWindowButton_Click">
                            <Path Width="9.5" Height="9.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M0.8,0.8 L8.7,8.7 M8.7,0.8 L0.8,8.7" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: LIQUID GLASS NAVIGATION + BREADCRUMB POD + SEARCH POD ==================== -->
            <Border x:Name="NavBarSurface"
                    Grid.Row="1"
                    Background="#E8FAFCFF"
                    BorderThickness="0"
                    Padding="10,3,12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="244" />
                    </Grid.ColumnDefinitions>

                    <!-- Left 4 SF Dual-Tone Navigation Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Style="{StaticResource GlassNavIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="后退 (Alt + ←)"
                                Click="BackButton_Click">
                            <Image Width="16" Height="16" Source="{StaticResource IconNavBack}" />
                        </Button>
                        <Button x:Name="ForwardButton"
                                Style="{StaticResource GlassNavIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="前进 (Alt + →)"
                                Click="ForwardButton_Click">
                            <Image Width="16" Height="16" Source="{StaticResource IconNavForward}" />
                        </Button>
                        <Button x:Name="UpButton"
                                Style="{StaticResource GlassNavIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="向上一级 (Alt + ↑ / 双击文件区空白处)"
                                Click="UpButton_Click">
                            <Image Width="16" Height="16" Source="{StaticResource IconNavUp}" />
                        </Button>
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource GlassNavIconButtonStyle}"
                                ToolTip="刷新 (F5)"
                                Click="RefreshButton_Click">
                            <Image Width="16" Height="16" Source="{StaticResource IconNavRefresh}" />
                        </Button>
                    </StackPanel>

                    <!-- Center: Elevated Frosted White Glass Breadcrumb / Address Pod -->
                    <Border x:Name="AddressBoxBorder"
                            Grid.Column="1"
                            Height="34"
                            Margin="8,0,10,0"
                            Background="#F0FFFFFF"
                            BorderBrush="#160F172A"
                            BorderThickness="1"
                            CornerRadius="9.5"
                            Padding="7,0,5,0"
                            MouseEnter="AddressBoxBorder_MouseEnter"
                            MouseLeave="AddressBoxBorder_MouseLeave">
                        <Grid>
                            <!-- Mode A: Interactive Breadcrumbs with Smooth Slide/Fade Transform -->
                            <Grid x:Name="BreadcrumbContainerGrid"
                                  Background="Transparent"
                                  MouseLeftButtonDown="BreadcrumbBlank_MouseLeftButtonDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Leading Dual-Tone Computer Icon + '>' -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BreadcrumbRootIconButton"
                                            Width="26" Height="25" Padding="0"
                                            Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                                            ToolTip="点击编辑完整路径 (Ctrl+L)"
                                            Click="BreadcrumbRootIconButton_Click">
                                        <Image Width="15.5" Height="15.5" Source="{StaticResource IconAddressComputer}" />
                                    </Button>
                                    <Path Width="4.8" Height="7.8" Stretch="Uniform"
                                          Margin="2,0,3,0" VerticalAlignment="Center"
                                          Stroke="#94A3B8" StrokeThickness="1.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M1,1 L4.5,4.5 L1,8" />
                                </StackPanel>

                                <!-- Dynamic Breadcrumb Nodes -->
                                <ScrollViewer x:Name="BreadcrumbScrollViewer"
                                              Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              MouseLeftButtonDown="BreadcrumbBlank_MouseLeftButtonDown">
                                    <StackPanel x:Name="BreadcrumbItemsPanel"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="BreadcrumbSlideTransform" X="0" />
                                        </StackPanel.RenderTransform>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Subtle Auto-Revealing Bookmark Star -->
                                <Button x:Name="BookmarkStarButton"
                                        Grid.Column="2"
                                        Width="26" Height="25" Padding="0"
                                        Opacity="0"
                                        Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                                        ToolTip="收藏当前文件夹到书签栏 (Ctrl+D)"
                                        Click="BookmarkStarButton_Click">
                                    <Path x:Name="BookmarkStarGlyph"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="#64748B" Fill="Transparent" StrokeThickness="1.3" StrokeLineJoin="Round"
                                          Data="M6.5,0.6 L8.3,4.3 L12.4,4.9 L9.4,7.8 L10.1,11.9 L6.5,9.9 L2.9,11.9 L3.6,7.8 L0.6,4.9 L4.7,4.3 Z" />
                                </Button>
                            </Grid>

                            <!-- Mode B: Full Path Text Edit + Autocomplete / History Popup -->
                            <Grid x:Name="AddressEditGrid" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image x:Name="AddressFolderIcon"
                                       Grid.Column="0"
                                       Width="15.5" Height="15.5"
                                       Margin="4,0,7,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <TextBox x:Name="AddressTextBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         FontSize="12.5"
                                         Foreground="#0F172A"
                                         SelectionBrush="#33007AFF"
                                         CaretBrush="#007AFF"
                                         GotKeyboardFocus="AddressTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="AddressTextBox_LostKeyboardFocus"
                                         PreviewKeyDown="AddressTextBox_PreviewKeyDown"
                                         KeyDown="AddressTextBox_KeyDown"
                                         TextChanged="AddressTextBox_TextChanged" />

                                <Border x:Name="AddressBusyIndicator"
                                        Grid.Column="2"
                                        Background="#1A007AFF"
                                        CornerRadius="5"
                                        Padding="7,2"
                                        Margin="4,0,2,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock Text="正在连接…"
                                               FontSize="11"
                                               Foreground="#0062CC" />
                                </Border>

                                <Button x:Name="AddressHistoryToggleButton"
                                        Grid.Column="3"
                                        Width="24" Height="24" Padding="0"
                                        Margin="2,0,1,0"
                                        Focusable="False"
                                        Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                                        ToolTip="展开最近访问与路径补全 (↓)"
                                        Click="AddressHistoryToggleButton_Click">
                                    <Path Width="8.5" Height="5" Stretch="Uniform"
                                          Stroke="#64748B" StrokeThickness="1.35"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M1,1 L4.5,4.5 L8,1" />
                                </Button>
                            </Grid>

                            <Popup x:Name="AddressSuggestPopup"
                                   PlacementTarget="{Binding ElementName=AddressBoxBorder}"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="True"
                                   Focusable="False">
                                <Border Width="{Binding ActualWidth, ElementName=AddressBoxBorder}"
                                        MaxHeight="306"
                                        Margin="0,0,0,6"
                                        Background="#FCFFFFFF"
                                        BorderBrush="#220F172A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4">
                                    <ListBox x:Name="AddressSuggestListBox"
                                             Focusable="False"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Padding" Value="9,5.5" />
                                                <Setter Property="Margin" Value="0,1" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="AddressSuggestItem_MouseLeftButtonUp" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ItemBd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="7"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ItemBd" Property="Background" Value="#14007AFF" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ItemBd" Property="Background" Value="#24007AFF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding DisplayTitle}"
                                                               FontSize="12.3"
                                                               FontWeight="Medium"
                                                               Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Subtitle}"
                                                               FontSize="11"
                                                               Foreground="#64748B"
                                                               Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <!-- Right: Elevated Frosted White Glass Async Search Pod -->
                    <Border x:Name="SearchBoxBorder"
                            Grid.Column="2"
                            Height="34"
                            Background="#F0FFFFFF"
                            BorderBrush="#160F172A"
                            BorderThickness="1"
                            CornerRadius="9.5"
                            Padding="11,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SearchPlaceholderText"
                                       Grid.Column="0"
                                       Text="在 此电脑 中搜索"
                                       Foreground="#8492A6"
                                       FontSize="12.2"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.4"
                                     Foreground="#0F172A"
                                     SelectionBrush="#33007AFF"
                                     CaretBrush="#007AFF"
                                     GotKeyboardFocus="SearchTextBox_GotKeyboardFocus"
                                     LostKeyboardFocus="SearchTextBox_LostKeyboardFocus"
                                     TextChanged="SearchTextBox_TextChanged"
                                     KeyDown="SearchTextBox_KeyDown" />

                            <Button x:Name="ClearSearchButton"
                                    Grid.Column="1"
                                    Width="22" Height="22" Padding="0"
                                    Visibility="Collapsed"
                                    Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                                    ToolTip="清除搜索 (Esc)"
                                    Click="ClearSearchButton_Click">
                                <Path Width="7.5" Height="7.5" Stretch="Uniform"
                                      Stroke="#64748B" StrokeThickness="1.35"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M0.5,0.5 L7.5,7.5 M7.5,0.5 L0.5,7.5" />
                            </Button>

                            <Button x:Name="SearchSubmitButton"
                                    Grid.Column="2"
                                    Width="26" Height="25" Padding="0"
                                    Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                                    ToolTip="搜索当前目录 (Enter)"
                                    Click="SearchSubmitButton_Click">
                                <Image Width="15" Height="15" Source="{StaticResource IconSearchMagnifier}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== ROW 2: FRAMELESS FLOATING COMMAND BAR (SF DUAL-TONE) ==================== -->
            <Border x:Name="CommandBarSurface"
                    Grid.Row="2"
                    Background="#ECF5F9FF"
                    BorderBrush="#160F172A"
                    BorderThickness="0,0,0,1"
                    Padding="10,0,12,2">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left & Middle Frameless Floating Command Strip -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- [⊕ 新建 ▾] -->
                        <Button x:Name="NewItemDropdownButton"
                                Style="{StaticResource GlassGhostCommandButtonStyle}"
                                ToolTip="在当前目录新建项目"
                                Click="NewItemDropdownButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="16.5" Height="16.5" Margin="0,0,6,0" Source="{StaticResource IconCmdNew}" />
                                <TextBlock Text="新建" VerticalAlignment="Center" />
                                <Path Width="6.8" Height="4" Stretch="Uniform"
                                      Margin="6,1,0,0" VerticalAlignment="Center"
                                      Stroke="#64748B" StrokeThickness="1.25"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M0.5,0.5 L3.5,3.5 L6.5,0.5" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="15" Fill="#1A0F172A" Margin="7,0" VerticalAlignment="Center" />

                        <!-- [✂ 剪切] -->
                        <Button x:Name="CutButton"
                                Style="{StaticResource GlassGhostIconCommandButtonStyle}"
                                IsEnabled="False"
                                ToolTip="剪切 (Ctrl+X)"
                                Click="CutButton_Click">
                            <Image Width="16.5" Height="16.5" Source="{StaticResource IconCmdCut}" />
                        </Button>

                        <!-- [❐ 复制] -->
                        <Button x:Name="CopyButton"
                                Style="{StaticResource GlassGhostIconCommandButtonStyle}"
                                IsEnabled="False"
                                ToolTip="复制 (Ctrl+C)"
                                Click="CopyButton_Click">
                            <Image Width="16.5" Height="16.5" Source="{StaticResource IconCmdCopy}" />
                        </Button>

                        <!-- [📋 粘贴] -->
                        <Button x:Name="PasteButton"
                                Style="{StaticResource GlassGhostIconCommandButtonStyle}"
                                IsEnabled="False"
                                ToolTip="粘贴 (Ctrl+V)"
                                Click="PasteButton_Click">
                            <Image Width="16.5" Height="16.5" Source="{StaticResource IconCmdPaste}" />
                        </Button>

                        <!-- [A| 重命名] -->
                        <Button x:Name="RenameButton"
                                Style="{StaticResource GlassGhostIconCommandButtonStyle}"
                                IsEnabled="False"
                                ToolTip="重命名 (F2)"
                                Click="RenameButton_Click">
                            <Image Width="16.5" Height="16.5" Source="{StaticResource IconCmdRename}" />
                        </Button>

                        <!-- [↪ 复制路径] -->
                        <Button x:Name="ShareCopyPathButton"
                                Style="{StaticResource GlassGhostIconCommandButtonStyle}"
                                IsEnabled="False"
                                ToolTip="复制选中项路径 (Ctrl+Shift+C)"
                                Click="ShareCopyPathButton_Click">
                            <Image Width="16.5" Height="16.5" Source="{StaticResource IconCmdCopyPath}" />
                        </Button>

                        <!-- [🗑 删除] -->
                        <Button x:Name="DeleteButton"
                                Style="{StaticResource GlassGhostIconCommandButtonStyle}"
                                IsEnabled="False"
                                ToolTip="删除 (Delete)"
                                Click="DeleteButton_Click">
                            <Image Width="16.5" Height="16.5" Source="{StaticResource IconCmdDelete}" />
                        </Button>

                        <Rectangle Width="1" Height="15" Fill="#1A0F172A" Margin="7,0" VerticalAlignment="Center" />

                        <!-- [⇅ 排序 ▾] -->
                        <Button x:Name="SortDropdownButton"
                                Style="{StaticResource GlassGhostCommandButtonStyle}"
                                ToolTip="排序方式"
                                Click="SortDropdownButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="16.5" Height="16.5" Margin="0,0,5,0" Source="{StaticResource IconCmdSort}" />
                                <TextBlock Text="排序" VerticalAlignment="Center" />
                                <Path Width="6.8" Height="4" Stretch="Uniform"
                                      Margin="5,1,0,0" VerticalAlignment="Center"
                                      Stroke="#64748B" StrokeThickness="1.25"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M0.5,0.5 L3.5,3.5 L6.5,0.5" />
                            </StackPanel>
                        </Button>

                        <!-- [☰ 查看 ▾] -->
                        <Button x:Name="ViewDropdownButton"
                                Style="{StaticResource GlassGhostCommandButtonStyle}"
                                ToolTip="视图模式与显示设置"
                                Click="ViewDropdownButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="16.5" Height="16.5" Margin="0,0,5,0" Source="{StaticResource IconCmdView}" />
                                <TextBlock Text="查看" VerticalAlignment="Center" />
                                <Path Width="6.8" Height="4" Stretch="Uniform"
                                      Margin="5,1,0,0" VerticalAlignment="Center"
                                      Stroke="#64748B" StrokeThickness="1.25"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M0.5,0.5 L3.5,3.5 L6.5,0.5" />
                            </StackPanel>
                        </Button>

                        <!-- [⋯ 更多] -->
                        <Button x:Name="MoreMenuButton"
                                Style="{StaticResource GlassGhostIconCommandButtonStyle}"
                                Margin="2,0,0,0"
                                ToolTip="查看更多"
                                Click="MoreMenuButton_Click">
                            <Image Width="16.5" Height="16.5" Source="{StaticResource IconCmdMore}" />
                        </Button>
                    </StackPanel>

                    <!-- Rightmost: [◫ 预览] -->
                    <Button x:Name="PreviewPaneButton"
                            Grid.Column="1"
                            Style="{StaticResource GlassGhostCommandButtonStyle}"
                            ToolTip="切换右侧预览窗格"
                            Click="PreviewPaneButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="16.5" Height="16.5" Margin="0,0,6,0" Source="{StaticResource IconCmdPreview}" />
                            <TextBlock x:Name="PreviewPaneText" Text="预览" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== ROW 3: COLLAPSIBLE BOOKMARK BAR (Ctrl+Shift+B) ==================== -->
            <Border x:Name="BookmarkBarBorder"
                    Grid.Row="3"
                    Height="32"
                    Background="#EEF5F9FF"
                    BorderBrush="#160F172A"
                    BorderThickness="0,0,0,1"
                    Padding="12,0"
                    AllowDrop="True"
                    Visibility="Collapsed"
                    DragOver="BookmarkBar_DragOver"
                    Drop="BookmarkBar_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Height="24"
                            Padding="7,0"
                            Margin="0,0,6,0"
                            Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                            Foreground="#0062CC"
                            ToolTip="将当前目录加入书签栏 (也可直接拖入文件夹)"
                            Click="BookmarkStarButton_Click">
                        <TextBlock Text="+ 收藏当前" FontSize="11.5" FontWeight="Medium" />
                    </Button>

                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <ItemsControl x:Name="BookmarksItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="24"
                                            Padding="7.5,0"
                                            Margin="0,0,3,0"
                                            Tag="{Binding}"
                                            ToolTip="{Binding ToolTipText}"
                                            Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                                            Click="BookmarkItem_Click"
                                            MouseUp="BookmarkItem_MouseUp"
                                            MouseRightButtonUp="BookmarkItem_MouseRightButtonUp">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Width="14" Height="14"
                                                   Margin="0,0,5,0"
                                                   Source="{Binding Icon}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Title}"
                                                       MaxWidth="140"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ==================== ROW 4: PURE OPAQUE #FFFFFF NATIVE FILE VIEW SURFACE ==================== -->
            <Grid x:Name="BrowserStackGrid"
                  Grid.Row="4"
                  Background="#FFFFFF" />

            <!-- ==================== ROW 5: CLOUD-MIST LIQUID GLASS FOOTER STATUS BAR ==================== -->
            <Border x:Name="BottomStatusBar"
                    Grid.Row="5"
                    Background="#DCEFF5FC"
                    BorderBrush="#160F172A"
                    BorderThickness="0,1,0,0"
                    Padding="14,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Bottom-Left: Item count + Selected count & total size -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLeftText"
                                   Text="就绪"
                                   FontSize="11.5"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusTransientText"
                                   Text=""
                                   FontSize="11.5"
                                   Foreground="#0062CC"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Bottom-Right: Frosted Glass Segmented Quick View Capsule [ ☰ | ⊞ ] -->
                    <Border Grid.Column="1"
                            Height="21"
                            CornerRadius="6"
                            BorderBrush="#160F172A"
                            BorderThickness="1"
                            Background="#D9FFFFFF"
                            Padding="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DetailsQuickButton"
                                    Width="26" Height="17" Padding="0"
                                    Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                                    ToolTip="详细信息视图"
                                    Click="DetailsViewButton_Click">
                                <Path x:Name="DetailsQuickGlyph"
                                      Width="11" Height="9" Stretch="Uniform"
                                      Stroke="#007AFF" StrokeThickness="1.35"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M0.5,1 H10.5 M0.5,4.5 H10.5 M0.5,8 H10.5" />
                            </Button>
                            <Rectangle Width="1" Height="11" Fill="#160F172A" Margin="1,0" VerticalAlignment="Center" />
                            <Button x:Name="IconsQuickButton"
                                    Width="26" Height="17" Padding="0"
                                    Style="{StaticResource GlassBreadcrumbSegmentButtonStyle}"
                                    ToolTip="大图标缩略图视图"
                                    Click="IconViewButton_Click">
                                <Path x:Name="IconsQuickGlyph"
                                      Width="10" Height="10" Stretch="Uniform"
                                      Stroke="#64748B" StrokeThickness="1.25" StrokeLineJoin="Round"
                                      Data="M0.6,0.6 H4.2 V4.2 H0.6 Z M5.8,0.6 H9.4 V4.2 H5.8 Z M0.6,5.8 H4.2 V9.4 H0.6 Z M5.8,5.8 H9.4 V9.4 H5.8 Z" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
