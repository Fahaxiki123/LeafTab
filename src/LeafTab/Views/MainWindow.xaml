<Window x:Class="LeafTab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LeafTab"
        Width="1120"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        Background="#EEF2F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Clean icon button style for Navigation Bar -->
        <Style x:Key="NavIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Buttons (Min / Max / Close) -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE3EC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C50F1F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrameBorder"
            Background="#EEF2F6"
            BorderBrush="#CBD5E1"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Integrated Win11-style Title Bar + Tab Strip -->
                <RowDefinition Height="38" />
                <!-- Row 1: Single-line Navigation & Address Bar -->
                <RowDefinition Height="40" />
                <!-- Row 2: Native IExplorerBrowser Host Container (Strict Airspace Boundary) -->
                <RowDefinition Height="*" />
                <!-- Row 3: Lightweight Status Bar -->
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: TITLE BAR + TABS ==================== -->
            <Grid Grid.Row="0" Background="#EEF2F6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Leaf Icon -->
                <Border Grid.Column="0" Padding="12,6,6,0" VerticalAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Fill="#16A34A"
                          ToolTip="LeafTab (一叶)"
                          Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z" />
                </Border>

                <!-- Tab Strip + New Tab Button -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="2,6,12,0"
                            Background="Transparent"
                            PreviewMouseWheel="TabStrip_PreviewMouseWheel">

                    <ScrollViewer x:Name="TabScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  MaxWidth="880"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl x:Name="TabsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabPill"
                                            Height="32"
                                            MinWidth="128"
                                            MaxWidth="220"
                                            Margin="0,0,3,0"
                                            Padding="10,0,6,0"
                                            CornerRadius="8,8,0,0"
                                            BorderThickness="1,1,1,0"
                                            Background="#E3E9F0"
                                            BorderBrush="Transparent"
                                            AllowDrop="True"
                                            Cursor="Arrow"
                                            ToolTip="{Binding ToolTipText}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            MouseLeftButtonDown="TabPill_MouseLeftButtonDown"
                                            MouseUp="TabPill_MouseUp"
                                            DragEnter="TabPill_DragEnter"
                                            DragOver="TabPill_DragOver"
                                            DragLeave="TabPill_DragLeave"
                                            Drop="TabPill_Drop">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Width="16"
                                                   Height="16"
                                                   Margin="0,0,7,0"
                                                   VerticalAlignment="Center"
                                                   Source="{Binding Icon}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="#1E293B"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Button Grid.Column="2"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding}"
                                                    ToolTip="关闭标签页 (Ctrl+W / 双击标签)"
                                                    Focusable="False"
                                                    Click="CloseTabButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="CloseBd" Background="Transparent" CornerRadius="4">
                                                            <Path Width="8" Height="8" Stretch="Uniform"
                                                                  Stroke="#64748B" StrokeThickness="1.4"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Data="M0,0 L8,8 M8,0 L0,8" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CloseBd" Property="Background" Value="#CBD5E1" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TabPill" Property="Background" Value="#FFFFFF" />
                                            <Setter TargetName="TabPill" Property="BorderBrush" Value="#D8E0EA" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TabPill" Property="Background" Value="#EAEFF5" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsDragHoverTarget}" Value="True">
                                            <Setter TargetName="TabPill" Property="Background" Value="#DBEAFE" />
                                            <Setter TargetName="TabPill" Property="BorderBrush" Value="#3B82F6" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- New Tab [+] Button -->
                    <Button Width="28"
                            Height="26"
                            Margin="2,0,0,3"
                            VerticalAlignment="Bottom"
                            ToolTip="新建标签页 (Ctrl+T)"
                            Style="{StaticResource NavIconButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="NewTabButton_Click">
                        <Path Width="11" Height="11" Stretch="Uniform"
                              Stroke="#334155" StrokeThickness="1.6"
                              Data="M5.5,0 L5.5,11 M0,5.5 L11,5.5" />
                    </Button>
                </StackPanel>

                <!-- Caption Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="最小化"
                            Click="MinimizeButton_Click">
                        <Path Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M0,0 H10 V1 H0 Z" />
                    </Button>
                    <Button x:Name="MaxRestoreButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="最大化"
                            Click="MaxRestoreButton_Click">
                        <Path x:Name="MaxRestoreGlyph"
                              Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}"
                            ToolTip="关闭"
                            Click="CloseWindowButton_Click">
                        <Path Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              Data="M0,0 L10,10 M10,0 L0,10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ==================== ROW 1: NAVIGATION & ADDRESS BAR ==================== -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Back / Forward / Up / Refresh -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Style="{StaticResource NavIconButtonStyle}"
                                ToolTip="后退 (Alt + ←)"
                                Click="BackButton_Click">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M13,6.5 H1 M6.5,1 L1,6.5 L6.5,12" />
                        </Button>
                        <Button Style="{StaticResource NavIconButtonStyle}"
                                ToolTip="前进 (Alt + →)"
                                Click="ForwardButton_Click">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M1,6.5 H13 M7.5,1 L13,6.5 L7.5,12" />
                        </Button>
                        <Button Style="{StaticResource NavIconButtonStyle}"
                                ToolTip="向上一级 (Alt + ↑ / 双击文件区空白处)"
                                Click="UpButton_Click">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M6.5,13 V1 M1,6.5 L6.5,1 L12,6.5" />
                        </Button>
                        <Button Style="{StaticResource NavIconButtonStyle}"
                                ToolTip="刷新 (F5)"
                                Click="RefreshButton_Click">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M11.5,2.5 A5.5,5.5 0 1 0 12.5,7 M11.5,0.5 V3.2 H8.8" />
                        </Button>
                    </StackPanel>

                    <!-- Address Box -->
                    <Border x:Name="AddressBoxBorder"
                            Grid.Column="1"
                            Height="28"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddressTextBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.5"
                                     Foreground="#0F172A"
                                     GotKeyboardFocus="AddressTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="AddressTextBox_PreviewMouseLeftButtonDown"
                                     KeyDown="AddressTextBox_KeyDown" />
                            <TextBlock x:Name="AddressBusyIndicator"
                                       Grid.Column="1"
                                       Text="正在检查路径..."
                                       FontSize="11.5"
                                       Foreground="#2563EB"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== ROW 2: NATIVE IExplorerBrowser STACK ==================== -->
            <Grid x:Name="BrowserStackGrid"
                  Grid.Row="2"
                  Background="#FFFFFF" />

            <!-- ==================== ROW 3: LIGHTWEIGHT STATUS BAR ==================== -->
            <Border Grid.Row="3"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLeftText"
                               Grid.Column="0"
                               Text="就绪"
                               FontSize="11.5"
                               Foreground="#475569"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusRightText"
                               Grid.Column="1"
                               Text="x64"
                               FontSize="11.5"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
