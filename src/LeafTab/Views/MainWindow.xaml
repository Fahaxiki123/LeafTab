<Window x:Class="LeafTab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LeafTab"
        Width="1140"
        Height="730"
        MinWidth="660"
        MinHeight="440"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="MainWindowChrome"
                            CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,86,0,24"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Apple Dual-Rim Outer Hairline: crisp 360-degree definition on light frosted glass -->
        <LinearGradientBrush x:Key="GlassCapsuleRimBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1C0F172A" Offset="0.0" />
            <GradientStop Color="#220F172A" Offset="0.5" />
            <GradientStop Color="#300F172A" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActiveCapsuleFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FCFFFFFF" Offset="0.0" />
            <GradientStop Color="#F0F8FAFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ToolbarCapsuleFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F7FFFFFF" Offset="0.0" />
            <GradientStop Color="#E8F6F9FE" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AddressPodRestFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FAFFFFFF" Offset="0.0" />
            <GradientStop Color="#EEF8FAFF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Soft floating glass button (New Tab [+], Up [↑], Embedded Refresh [↻]) -->
        <Style x:Key="GlassFloatingButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7AFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B8FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#52E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented capsule inner button (Left / Right / Solo inside a glass capsule) -->
        <Style x:Key="CapsuleSegmentButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="33" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegBd" Property="Background" Value="#68FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegBd" Property="Background" Value="#3894A3B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Top-Right Floating Window Controls -->
        <Style x:Key="MinimalCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#7AFFFFFF" />
                                <Setter TargetName="CapBd" Property="BorderBrush" Value="#A8FFFFFF" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#44CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource MinimalCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#EBFF3B30" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#D6E02E24" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrameBorder" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Unified Liquid-Glass Header (Floating Capsule Tabs + Safari Address Bar) -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Native IExplorerBrowser Host Container (Pure Light Surface for Crisp Reading) -->
                <RowDefinition Height="*" />
                <!-- Row 2: Minimalist Finder-inspired Translucent Footer -->
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- ==================== UNIFIED LIQUID-GLASS TOP CHROME ==================== -->
            <Border x:Name="TopGlassSurface"
                    Grid.Row="0"
                    BorderBrush="#1F0F172A"
                    BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush x:Name="HeaderGlassGradient" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="HeaderTopStop" Color="#CCF7FAFF" Offset="0.0" />
                        <GradientStop x:Name="HeaderBottomStop" Color="#DCF0F5FC" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <!-- Subtle 1px top inner specular highlight line -->
                <Border BorderBrush="#B8FFFFFF" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Layer 1: Floating Liquid-Glass Capsule Tabs + Minimalist Right Controls -->
                            <RowDefinition Height="41" />
                            <!-- Layer 2: Safari Symmetric Capsule Toolbar & Unified Address Pod -->
                            <RowDefinition Height="43" />
                        </Grid.RowDefinitions>

                        <!-- ========== LAYER 1: FLOATING CAPSULE TAB BAR ========== -->
                        <Grid Grid.Row="0" Margin="12,5,10,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Subtle Leaf Emblem -->
                            <Border Grid.Column="0"
                                    Width="27" Height="27"
                                    Margin="0,0,7,0"
                                    CornerRadius="8.5"
                                    Background="#E0FFFFFF"
                                    BorderBrush="#1A0F172A"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    ToolTip="LeafTab (一叶)">
                                <Path Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#22C55E" Offset="0.0" />
                                            <GradientStop Color="#15803D" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                            </Border>

                            <!-- Floating Capsule Tabs + [+] Pill -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        PreviewMouseWheel="TabStrip_PreviewMouseWheel">

                                <ScrollViewer x:Name="TabScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              MaxWidth="880"
                                              Padding="1,2,1,3"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <ItemsControl x:Name="TabsItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="TabPill"
                                                        Height="29"
                                                        MinWidth="126"
                                                        MaxWidth="216"
                                                        Margin="0,0,5,0"
                                                        Padding="10,0,6,0"
                                                        CornerRadius="9.5"
                                                        BorderThickness="1"
                                                        Background="#58FFFFFF"
                                                        BorderBrush="#100F172A"
                                                        AllowDrop="True"
                                                        Cursor="Arrow"
                                                        ToolTip="{Binding ToolTipText}"
                                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                        MouseLeftButtonDown="TabPill_MouseLeftButtonDown"
                                                        MouseUp="TabPill_MouseUp"
                                                        DragEnter="TabPill_DragEnter"
                                                        DragOver="TabPill_DragOver"
                                                        DragLeave="TabPill_DragLeave"
                                                        Drop="TabPill_Drop">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Column="0"
                                                               Width="15"
                                                               Height="15"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Source="{Binding Icon}" />

                                                        <TextBlock x:Name="TabTitleText"
                                                                   Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12.2"
                                                                   Foreground="#334155"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <Button x:Name="CloseTabBtn"
                                                                Grid.Column="2"
                                                                Width="18"
                                                                Height="18"
                                                                Margin="5,0,0,0"
                                                                Opacity="0"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding}"
                                                                ToolTip="关闭标签页 (Ctrl+W / 双击标签)"
                                                                Focusable="False"
                                                                Click="CloseTabButton_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="CloseBd" Background="Transparent" CornerRadius="9">
                                                                        <Path x:Name="CloseGlyph"
                                                                              Width="7.2" Height="7.2" Stretch="Uniform"
                                                                              Stroke="#64748B" StrokeThickness="1.35"
                                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                              Data="M0,0 L7,7 M7,0 L0,7" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CloseBd" Property="Background" Value="#1C0F172A" />
                                                                            <Setter TargetName="CloseGlyph" Property="Stroke" Value="#0F172A" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <DataTemplate.Triggers>
                                                    <!-- Active Liquid-Glass Capsule -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="TabPill" Property="Background" Value="{StaticResource ActiveCapsuleFillBrush}" />
                                                        <Setter TargetName="TabPill" Property="BorderBrush" Value="{StaticResource GlassCapsuleRimBrush}" />
                                                        <Setter TargetName="TabTitleText" Property="Foreground" Value="#0F172A" />
                                                        <Setter TargetName="TabTitleText" Property="FontWeight" Value="Medium" />
                                                        <Setter TargetName="CloseTabBtn" Property="Opacity" Value="0.72" />
                                                        <Setter TargetName="TabPill" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1.2" Direction="270" Opacity="0.07" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>

                                                    <!-- Inactive Hover Bloom -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="TabPill" Property="Background" Value="#BAFFFFFF" />
                                                        <Setter TargetName="TabPill" Property="BorderBrush" Value="#1E0F172A" />
                                                        <Setter TargetName="TabTitleText" Property="Foreground" Value="#0F172A" />
                                                        <Setter TargetName="CloseTabBtn" Property="Opacity" Value="0.78" />
                                                    </MultiDataTrigger>

                                                    <!-- Cross-Tab File Drag Hover Highlight (Apple System Blue Glass) -->
                                                    <DataTrigger Binding="{Binding IsDragHoverTarget}" Value="True">
                                                        <Setter TargetName="TabPill" Property="Background" Value="#36007AFF" />
                                                        <Setter TargetName="TabPill" Property="BorderBrush" Value="#B8007AFF" />
                                                        <Setter TargetName="TabTitleText" Property="Foreground" Value="#0051D5" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Floating [+] New Tab Capsule Button -->
                                <Button Width="28"
                                        Height="28"
                                        Margin="1,0,0,1"
                                        VerticalAlignment="Center"
                                        ToolTip="新建标签页 (Ctrl+T)"
                                        Style="{StaticResource GlassFloatingButtonStyle}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="NewTabButton_Click">
                                    <Path Width="10.5" Height="10.5" Stretch="Uniform"
                                          Stroke="#334155" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M5.25,0.5 V10 M0.5,5.25 H10" />
                                </Button>
                            </StackPanel>

                            <!-- Top-Right Minimalist Floating Window Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Style="{StaticResource MinimalCaptionButtonStyle}"
                                        ToolTip="最小化"
                                        Click="MinimizeButton_Click">
                                    <Path Width="9.5" Height="2"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M0.5,1 H9" />
                                </Button>
                                <Button x:Name="MaxRestoreButton"
                                        Style="{StaticResource MinimalCaptionButtonStyle}"
                                        ToolTip="最大化"
                                        Click="MaxRestoreButton_Click">
                                    <Path x:Name="MaxRestoreGlyph"
                                          Width="9" Height="9"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3" StrokeLineJoin="Round"
                                          Data="M1.8,0.6 H7.2 A1.2,1.2 0 0 1 8.4,1.8 V7.2 A1.2,1.2 0 0 1 7.2,8.4 H1.8 A1.2,1.2 0 0 1 0.6,7.2 V1.8 A1.2,1.2 0 0 1 1.8,0.6 Z" />
                                </Button>
                                <Button Style="{StaticResource MinimalCloseButtonStyle}"
                                        ToolTip="关闭"
                                        Click="CloseWindowButton_Click">
                                    <Path Width="8.8" Height="8.8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M0.6,0.6 L8.2,8.2 M8.2,0.6 L0.6,8.2" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ========== LAYER 2: SAFARI FLOATING CAPSULE TOOLBAR & ADDRESS POD ========== -->
                        <Grid Grid.Row="1" Margin="12,1,12,8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Segmented Navigation Capsule [ ‹ | › ] + [ ↑ ] -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Height="32"
                                        CornerRadius="9.5"
                                        Background="{StaticResource ToolbarCapsuleFillBrush}"
                                        BorderBrush="{StaticResource GlassCapsuleRimBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.04" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource CapsuleSegmentButtonStyle}"
                                                ToolTip="后退 (Alt + ←)"
                                                Click="BackButton_Click">
                                            <Path Width="7" Height="12" Stretch="Uniform"
                                                  Stroke="#334155" StrokeThickness="1.55"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M6,1 L1,6 L6,11" />
                                        </Button>
                                        <Rectangle Width="1" Height="14" Fill="#160F172A" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource CapsuleSegmentButtonStyle}"
                                                ToolTip="前进 (Alt + →)"
                                                Click="ForwardButton_Click">
                                            <Path Width="7" Height="12" Stretch="Uniform"
                                                  Stroke="#334155" StrokeThickness="1.55"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M1,1 L6,6 L1,11" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Height="32" Width="34"
                                        Margin="6,0,0,0"
                                        CornerRadius="9.5"
                                        Background="{StaticResource ToolbarCapsuleFillBrush}"
                                        BorderBrush="{StaticResource GlassCapsuleRimBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.04" />
                                    </Border.Effect>
                                    <Button Width="32" Height="30"
                                            Style="{StaticResource CapsuleSegmentButtonStyle}"
                                            ToolTip="向上一级 (Alt + ↑ / 双击文件区空白处)"
                                            Click="UpButton_Click">
                                        <Path Width="11" Height="12" Stretch="Uniform"
                                              Stroke="#334155" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M5.5,11.5 V1.2 M1,5.6 L5.5,1.1 L10,5.6" />
                                    </Button>
                                </Border>
                            </StackPanel>

                            <!-- Center: Safari Unified Floating Liquid-Glass Address Capsule (with Embedded Refresh) -->
                            <Border x:Name="AddressBoxBorder"
                                    Grid.Column="1"
                                    Height="32"
                                    Margin="10,0"
                                    Background="{StaticResource AddressPodRestFillBrush}"
                                    BorderBrush="{StaticResource GlassCapsuleRimBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,0,4,0">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="AddressPodShadow"
                                                      Color="#0F172A"
                                                      BlurRadius="7"
                                                      ShadowDepth="1"
                                                      Direction="270"
                                                      Opacity="0.045" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Folder Favicon inside left of Address Pod -->
                                    <Image x:Name="AddressFolderIcon"
                                           Grid.Column="0"
                                           Width="14" Height="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Opacity="0.88"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <TextBox x:Name="AddressTextBox"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             FontSize="12.5"
                                             Foreground="#0F172A"
                                             SelectionBrush="#33007AFF"
                                             CaretBrush="#007AFF"
                                             GotKeyboardFocus="AddressTextBox_GotKeyboardFocus"
                                             LostKeyboardFocus="AddressTextBox_LostKeyboardFocus"
                                             PreviewMouseLeftButtonDown="AddressTextBox_PreviewMouseLeftButtonDown"
                                             KeyDown="AddressTextBox_KeyDown" />

                                    <!-- Async Network Check Pill -->
                                    <Border x:Name="AddressBusyIndicator"
                                            Grid.Column="2"
                                            Background="#1A007AFF"
                                            CornerRadius="6"
                                            Padding="7,2"
                                            Margin="6,0,2,0"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <TextBlock Text="正在连接…"
                                                   FontSize="11"
                                                   Foreground="#0066CC" />
                                    </Border>

                                    <!-- Safari-style Embedded Refresh Button inside right edge of Address Pod -->
                                    <Button Grid.Column="3"
                                            Width="24" Height="24"
                                            VerticalAlignment="Center"
                                            ToolTip="刷新当前目录 (F5)"
                                            Style="{StaticResource GlassFloatingButtonStyle}"
                                            Click="RefreshButton_Click">
                                        <Path Width="11.5" Height="11.5" Stretch="Uniform"
                                              Stroke="#64748B" StrokeThickness="1.45"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M10.5,2.4 A5,5 0 1 0 11.4,6.4 M10.6,0.5 V3.0 H8.1" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Right: Segmented View Switcher Capsule [ 详细信息 | 大图标 ] -->
                            <Border Grid.Column="2"
                                    Height="32"
                                    CornerRadius="9.5"
                                    Background="{StaticResource ToolbarCapsuleFillBrush}"
                                    BorderBrush="{StaticResource GlassCapsuleRimBrush}"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.04" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DetailsViewButton"
                                            Style="{StaticResource CapsuleSegmentButtonStyle}"
                                            ToolTip="详细信息视图"
                                            Click="DetailsViewButton_Click">
                                        <Path x:Name="DetailsViewGlyph"
                                              Width="12" Height="10" Stretch="Uniform"
                                              Stroke="#0066CC" StrokeThickness="1.45"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M0.5,1.2 H11.5 M0.5,5 H11.5 M0.5,8.8 H11.5" />
                                    </Button>
                                    <Rectangle Width="1" Height="14" Fill="#160F172A" VerticalAlignment="Center" />
                                    <Button x:Name="IconViewButton"
                                            Style="{StaticResource CapsuleSegmentButtonStyle}"
                                            ToolTip="大图标视图"
                                            Click="IconViewButton_Click">
                                        <Path x:Name="IconViewGlyph"
                                              Width="11" Height="11" Stretch="Uniform"
                                              Stroke="#475569" StrokeThickness="1.35"
                                              StrokeLineJoin="Round"
                                              Data="M0.6,0.6 H4.4 V4.4 H0.6 Z M6.6,0.6 H10.4 V4.4 H6.6 Z M0.6,6.6 H4.4 V10.4 H0.6 Z M6.6,6.6 H10.4 V10.4 H6.6 Z" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- ==================== PURE LIGHT NATIVE FILE VIEW SURFACE ==================== -->
            <Grid x:Name="BrowserStackGrid"
                  Grid.Row="1"
                  Background="#FFFFFF" />

            <!-- ==================== FINDER-INSPIRED MINIMALIST GLASS FOOTER ==================== -->
            <Border x:Name="BottomGlassFooter"
                    Grid.Row="2"
                    Background="#9AF8FAFC"
                    BorderBrush="#160F172A"
                    BorderThickness="0,1,0,0"
                    Padding="14,0">
                <Grid>
                    <TextBlock x:Name="StatusCenterText"
                               Text="就绪"
                               FontSize="11.3"
                               Foreground="#526071"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusRightText"
                               Text="x64"
                               FontSize="10.8"
                               Foreground="#8A99AD"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
