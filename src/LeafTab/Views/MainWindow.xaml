<Window x:Class="LeafTab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LeafTab"
        Width="1160"
        Height="740"
        MinWidth="720"
        MinHeight="460"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="MainWindowChrome"
                            CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,38,0,0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ==================== WIN11 FLUENT CONTEXT MENU & MENU ITEM STYLES ==================== -->
        <Style x:Key="Win11MenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#E5EAF1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="8,6,14,6" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBd"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="CheckGlyph"
                                          Width="10" Height="8" Stretch="Uniform"
                                          Stroke="#0067C0" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          Data="M1,4.2 L3.8,7 L9.2,1" />
                                    <ContentPresenter x:Name="IconHost"
                                                      ContentSource="Icon"
                                                      Width="16" Height="16"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />
                                </Grid>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,12,0" />

                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#7B8798"
                                           FontSize="11.5"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#EFF3F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11ContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Win11MenuItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="6,4,8,10"
                                Background="#FCFDFF"
                                BorderBrush="#D5DCE6"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="2,4">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.14" />
                            </Border.Effect>
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== WIN11 NAVIGATION & COMMAND BUTTON STYLES ==================== -->
        <Style x:Key="Win11NavIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#2C3440" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4EAF2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8E0EC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11CommandButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF3F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3E9F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11CommandIconButtonStyle" TargetType="Button" BasedOn="{StaticResource Win11CommandButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="Win11BreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="12.3" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== WIN11 TOP-RIGHT WINDOW CAPTION BUTTONS ==================== -->
        <Style x:Key="Win11CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource Win11CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#B12618" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrameBorder" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Win11 Mica Tab Strip + Left LeafTab Icon + Right Caption Buttons -->
                <RowDefinition Height="38" />
                <!-- Row 1: Win11 Navigation Buttons + Interactive Breadcrumb Bar + Async Search Box -->
                <RowDefinition Height="44" />
                <!-- Row 2: Win11 Command Bar (New, Cut/Copy/Paste/Rename/Share/Delete, Sort, View, More, Preview) -->
                <RowDefinition Height="44" />
                <!-- Row 3: Collapsible Bookmark Bar (Ctrl+Shift+B) -->
                <RowDefinition Height="Auto" />
                <!-- Row 4: Native IExplorerBrowser Host Surface -->
                <RowDefinition Height="*" />
                <!-- Row 5: Win11 Footer Status Bar (Item count / Selected size + Quick view toggle) -->
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: WIN11 CONNECTED TAB BAR ==================== -->
            <Border x:Name="TabTitleBarSurface"
                    Grid.Row="0"
                    Panel.ZIndex="5"
                    Background="#CCDCE4EE"
                    BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left LeafTab App Emblem (User requested keeping this icon on top-left) -->
                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            Margin="10,4,6,0"
                            CornerRadius="6"
                            Background="#ECFFFFFF"
                            BorderBrush="#1A0F172A"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="LeafTab（一叶）">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22C55E" Offset="0.0" />
                                    <GradientStop Color="#15803D" Offset="1.0" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Border>

                    <!-- Connected Win11 Tabs + [+] New Tab Button -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                PreviewMouseWheel="TabStrip_PreviewMouseWheel">

                        <ScrollViewer x:Name="TabScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      MaxWidth="920"
                                      VerticalAlignment="Bottom"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ItemsControl x:Name="TabsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Bottom" Margin="0,6,0,0">
                                            <!-- Subtle right vertical separator between inactive tabs -->
                                            <Rectangle x:Name="InactiveSeparator"
                                                       Width="1" Height="16"
                                                       Fill="#BCC6D4"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />

                                            <Border x:Name="TabPill"
                                                    Height="31"
                                                    MinWidth="150"
                                                    MaxWidth="226"
                                                    Padding="11,0,6,0"
                                                    CornerRadius="7,7,0,0"
                                                    BorderThickness="1,1,1,0"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    AllowDrop="True"
                                                    ToolTip="{Binding ToolTipText}"
                                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                    MouseLeftButtonDown="TabPill_MouseLeftButtonDown"
                                                    MouseMove="TabPill_MouseMove"
                                                    MouseLeftButtonUp="TabPill_MouseLeftButtonUp"
                                                    MouseUp="TabPill_MouseUp"
                                                    DragEnter="TabPill_DragEnter"
                                                    DragOver="TabPill_DragOver"
                                                    DragLeave="TabPill_DragLeave"
                                                    Drop="TabPill_Drop">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Column="0"
                                                           Width="16"
                                                           Height="16"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Icon}" />

                                                    <TextBlock x:Name="TabTitleText"
                                                               Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="#334155"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <Button x:Name="CloseTabBtn"
                                                            Grid.Column="2"
                                                            Width="22"
                                                            Height="20"
                                                            Margin="6,0,0,0"
                                                            Opacity="0.72"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding}"
                                                            ToolTip="关闭标签页 (Ctrl+W)"
                                                            Focusable="False"
                                                            Click="CloseTabButton_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="CloseBd" Background="Transparent" CornerRadius="4">
                                                                    <Path x:Name="CloseGlyph"
                                                                          Width="8" Height="8" Stretch="Uniform"
                                                                          Stroke="#475569" StrokeThickness="1.25"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Data="M0.5,0.5 L7.5,7.5 M7.5,0.5 L0.5,7.5" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CloseBd" Property="Background" Value="#19000000" />
                                                                        <Setter TargetName="CloseGlyph" Property="Stroke" Value="#0F172A" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <!-- Active Win11 Tab seamlessly fused into Row 1 (#F3F6FA) -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="TabPill" Property="Background" Value="#F3F6FA" />
                                                <Setter TargetName="TabPill" Property="BorderBrush" Value="#D5DCE6" />
                                                <Setter TargetName="TabPill" Property="CornerRadius" Value="8,8,0,0" />
                                                <Setter TargetName="TabPill" Property="Height" Value="32" />
                                                <Setter TargetName="TabTitleText" Property="Foreground" Value="#0F172A" />
                                                <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="CloseTabBtn" Property="Opacity" Value="0.88" />
                                                <Setter TargetName="InactiveSeparator" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>

                                            <!-- Inactive Tab Hover -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TabPill" Property="Background" Value="#6EFFFFFF" />
                                                <Setter TargetName="TabTitleText" Property="Foreground" Value="#0F172A" />
                                                <Setter TargetName="InactiveSeparator" Property="Visibility" Value="Hidden" />
                                            </MultiDataTrigger>

                                            <!-- Cross-Tab File Drag Hover Highlight -->
                                            <DataTrigger Binding="{Binding IsDragHoverTarget}" Value="True">
                                                <Setter TargetName="TabPill" Property="Background" Value="#D6E8FC" />
                                                <Setter TargetName="TabPill" Property="BorderBrush" Value="#0067C0" />
                                                <Setter TargetName="TabTitleText" Property="Foreground" Value="#005099" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Win11 [+] New Tab Button -->
                        <Button Width="30"
                                Height="26"
                                Margin="4,8,0,2"
                                VerticalAlignment="Bottom"
                                ToolTip="新建标签页 (Ctrl+T)"
                                Style="{StaticResource Win11NavIconButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="NewTabButton_Click">
                            <Path Width="10.5" Height="10.5" Stretch="Uniform"
                                  Stroke="#2C3440" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5.25,0.5 V10 M0.5,5.25 H10" />
                        </Button>
                    </StackPanel>

                    <!-- Top-Right Standard Win11 Window Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Win11CaptionButtonStyle}"
                                ToolTip="最小化"
                                Click="MinimizeButton_Click">
                            <Path Width="10" Height="2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  Data="M0,1 H10" />
                        </Button>
                        <Button x:Name="MaxRestoreButton"
                                Style="{StaticResource Win11CaptionButtonStyle}"
                                ToolTip="最大化"
                                Click="MaxRestoreButton_Click">
                            <Path x:Name="MaxRestoreGlyph"
                                  Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                        </Button>
                        <Button Style="{StaticResource Win11CloseCaptionButtonStyle}"
                                ToolTip="关闭"
                                Click="CloseWindowButton_Click">
                            <Path Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.15"
                                  Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: WIN11 NAVIGATION + BREADCRUMB + SEARCH BAR ==================== -->
            <Border Grid.Row="1"
                    Background="#F3F6FA"
                    BorderBrush="#E1E6EE"
                    BorderThickness="0,0,0,1"
                    Padding="8,0,12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="248" />
                    </Grid.ColumnDefinitions>

                    <!-- Left 4 Navigation Buttons: Back, Forward, Up, Refresh -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Style="{StaticResource Win11NavIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="后退 (Alt + ←)"
                                Click="BackButton_Click">
                            <Path Width="13" Height="12" Stretch="Uniform"
                                  Stroke="#2C3440" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M12,6 H1.2 M6,1.2 L1.2,6 L6,10.8" />
                        </Button>
                        <Button x:Name="ForwardButton"
                                Style="{StaticResource Win11NavIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="前进 (Alt + →)"
                                Click="ForwardButton_Click">
                            <Path Width="13" Height="12" Stretch="Uniform"
                                  Stroke="#2C3440" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M1,6 H11.8 M7,1.2 L11.8,6 L7,10.8" />
                        </Button>
                        <Button x:Name="UpButton"
                                Style="{StaticResource Win11NavIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="向上一级 (Alt + ↑ / 双击文件区空白处)"
                                Click="UpButton_Click">
                            <Path Width="12" Height="13" Stretch="Uniform"
                                  Stroke="#2C3440" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M6,12 V1.2 M1.2,6 L6,1.2 L10.8,6" />
                        </Button>
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource Win11NavIconButtonStyle}"
                                ToolTip="刷新 (F5)"
                                Click="RefreshButton_Click">
                            <Path Width="12.5" Height="12.5" Stretch="Uniform"
                                  Stroke="#2C3440" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M10.5,2.4 A5,5 0 1 0 11.4,6.4 M10.6,0.5 V3.1 H8.0" />
                        </Button>
                    </StackPanel>

                    <!-- Center: Win11 Dual-Mode Address Box (Interactive Breadcrumb <-> Text Edit) -->
                    <Border x:Name="AddressBoxBorder"
                            Grid.Column="1"
                            Height="32"
                            Margin="6,0,10,0"
                            Background="#FFFFFF"
                            BorderBrush="#DCE2EA"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,0,4,0">
                        <Grid>
                            <!-- Mode A: Win11 Interactive Breadcrumbs -->
                            <Grid x:Name="BreadcrumbContainerGrid" Background="Transparent" MouseLeftButtonDown="BreadcrumbBlank_MouseLeftButtonDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Monitor / Folder Glyph + '>' -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BreadcrumbRootIconButton"
                                            Width="24" Height="24" Padding="0"
                                            Style="{StaticResource Win11BreadcrumbButtonStyle}"
                                            ToolTip="点击编辑完整路径 (Ctrl+L)"
                                            Click="BreadcrumbRootIconButton_Click">
                                        <Path Width="13.5" Height="12.5" Stretch="Uniform"
                                              Stroke="#475569" StrokeThickness="1.2" StrokeLineJoin="Round"
                                              Data="M1,1 H13 V9 H1 Z M4.5,12 H9.5 M7,9 V12" />
                                    </Button>
                                    <Path Width="5" Height="8" Stretch="Uniform"
                                          Margin="2,0,3,0" VerticalAlignment="Center"
                                          Stroke="#7B8798" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M1,1 L4.5,4.5 L1,8" />
                                </StackPanel>

                                <!-- Dynamic Breadcrumb Nodes -->
                                <ScrollViewer x:Name="BreadcrumbScrollViewer"
                                              Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              MouseLeftButtonDown="BreadcrumbBlank_MouseLeftButtonDown">
                                    <StackPanel x:Name="BreadcrumbItemsPanel"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center" />
                                </ScrollViewer>

                                <!-- Quick Bookmark Star Button inside right edge of Address Box -->
                                <Button x:Name="BookmarkStarButton"
                                        Grid.Column="2"
                                        Width="26" Height="24" Padding="0"
                                        Style="{StaticResource Win11BreadcrumbButtonStyle}"
                                        ToolTip="收藏当前文件夹到书签栏 (Ctrl+D)"
                                        Click="BookmarkStarButton_Click">
                                    <Path x:Name="BookmarkStarGlyph"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="#64748B" Fill="Transparent" StrokeThickness="1.25" StrokeLineJoin="Round"
                                          Data="M6.5,0.6 L8.3,4.3 L12.4,4.9 L9.4,7.8 L10.1,11.9 L6.5,9.9 L2.9,11.9 L3.6,7.8 L0.6,4.9 L4.7,4.3 Z" />
                                </Button>
                            </Grid>

                            <!-- Mode B: Full Path Text Edit -->
                            <Grid x:Name="AddressEditGrid" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image x:Name="AddressFolderIcon"
                                       Grid.Column="0"
                                       Width="15" Height="15"
                                       Margin="3,0,7,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <TextBox x:Name="AddressTextBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         FontSize="12.5"
                                         Foreground="#0F172A"
                                         SelectionBrush="#330067C0"
                                         CaretBrush="#0067C0"
                                         GotKeyboardFocus="AddressTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="AddressTextBox_LostKeyboardFocus"
                                         KeyDown="AddressTextBox_KeyDown" />

                                <Border x:Name="AddressBusyIndicator"
                                        Grid.Column="2"
                                        Background="#E6F0FA"
                                        CornerRadius="3"
                                        Padding="6,2"
                                        Margin="4,0,2,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock Text="正在连接…"
                                               FontSize="11"
                                               Foreground="#0067C0" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: Win11 Asynchronous Directory Search Box -->
                    <Border x:Name="SearchBoxBorder"
                            Grid.Column="2"
                            Height="32"
                            Background="#FFFFFF"
                            BorderBrush="#DCE2EA"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SearchPlaceholderText"
                                       Grid.Column="0"
                                       Text="在 此电脑 中搜索"
                                       Foreground="#758091"
                                       FontSize="12.2"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.3"
                                     Foreground="#0F172A"
                                     SelectionBrush="#330067C0"
                                     CaretBrush="#0067C0"
                                     GotKeyboardFocus="SearchTextBox_GotKeyboardFocus"
                                     LostKeyboardFocus="SearchTextBox_LostKeyboardFocus"
                                     TextChanged="SearchTextBox_TextChanged"
                                     KeyDown="SearchTextBox_KeyDown" />

                            <Button x:Name="ClearSearchButton"
                                    Grid.Column="1"
                                    Width="22" Height="22" Padding="0"
                                    Visibility="Collapsed"
                                    Style="{StaticResource Win11BreadcrumbButtonStyle}"
                                    ToolTip="清除搜索 (Esc)"
                                    Click="ClearSearchButton_Click">
                                <Path Width="8" Height="8" Stretch="Uniform"
                                      Stroke="#64748B" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M0.5,0.5 L7.5,7.5 M7.5,0.5 L0.5,7.5" />
                            </Button>

                            <Button x:Name="SearchSubmitButton"
                                    Grid.Column="2"
                                    Width="26" Height="24" Padding="0"
                                    Style="{StaticResource Win11BreadcrumbButtonStyle}"
                                    ToolTip="搜索当前目录 (Enter)"
                                    Click="SearchSubmitButton_Click">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Stroke="#5A6577" StrokeThickness="1.35"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M8.2,8.2 L11.5,11.5 M9.5,5 A4.5,4.5 0 1 1 0.5,5 A4.5,4.5 0 1 1 9.5,5 Z" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== ROW 2: WIN11 COMMAND BAR ==================== -->
            <Border Grid.Row="2"
                    Background="#FAFBFD"
                    BorderBrush="#E3E7EE"
                    BorderThickness="0,0,0,1"
                    Padding="8,0,10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left & Middle Win11 Command Strip -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- [⊕ 新建 ▾] -->
                        <Button x:Name="NewItemDropdownButton"
                                Style="{StaticResource Win11CommandButtonStyle}"
                                ToolTip="在当前目录新建项目"
                                Click="NewItemDropdownButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,6,0">
                                    <Ellipse Width="15" Height="15" Stroke="#0067C0" StrokeThickness="1.3" />
                                    <Path Width="7.5" Height="7.5" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="#0067C0" StrokeThickness="1.35"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M4,0.5 V7.5 M0.5,4 H7.5" />
                                </Grid>
                                <TextBlock Text="新建" VerticalAlignment="Center" />
                                <Path Width="7" Height="4" Stretch="Uniform"
                                      Margin="6,1,0,0" VerticalAlignment="Center"
                                      Stroke="#475569" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M0.5,0.5 L3.5,3.5 L6.5,0.5" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="18" Fill="#DCE2EA" Margin="6,0" VerticalAlignment="Center" />

                        <!-- [✂ 剪切] -->
                        <Button x:Name="CutButton"
                                Style="{StaticResource Win11CommandIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="剪切 (Ctrl+X)"
                                Click="CutButton_Click">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.25"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3.5,10 A2.2,2.2 0 1 1 1.3,12.2 A2.2,2.2 0 0 1 3.5,10 Z M10.5,10 A2.2,2.2 0 1 1 8.3,12.2 A2.2,2.2 0 0 1 10.5,10 Z M4.8,10.5 L11.5,1.5 M9.2,10.5 L2.5,1.5" />
                        </Button>

                        <!-- [❐ 复制] -->
                        <Button x:Name="CopyButton"
                                Style="{StaticResource Win11CommandIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="复制 (Ctrl+C)"
                                Click="CopyButton_Click">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.25" StrokeLineJoin="Round"
                                  Data="M4,3.5 H11.5 V12.5 H4 Z M1.5,10 V1.5 H9.5" />
                        </Button>

                        <!-- [📋 粘贴] -->
                        <Button x:Name="PasteButton"
                                Style="{StaticResource Win11CommandIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="粘贴 (Ctrl+V)"
                                Click="PasteButton_Click">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.25" StrokeLineJoin="Round"
                                  Data="M4.2,2.2 H2.2 V12.8 H11.8 V2.2 H9.8 M4.5,1 H9.5 V3.4 H4.5 Z" />
                        </Button>

                        <!-- [A| 重命名] -->
                        <Button x:Name="RenameButton"
                                Style="{StaticResource Win11CommandIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="重命名 (F2)"
                                Click="RenameButton_Click">
                            <Path Width="15" Height="14" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.25" StrokeLineJoin="Round"
                                  Data="M1,2.5 H9 V11.5 H1 Z M12,1 V13 M10.2,1 H13.8 M10.2,13 H13.8 M3,9.2 L5,4.6 L7,9.2 M3.6,8 H6.4" />
                        </Button>

                        <!-- [↪ 共享 / 复制路径] -->
                        <Button x:Name="ShareCopyPathButton"
                                Style="{StaticResource Win11CommandIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="复制选中项路径 (Ctrl+Shift+C)"
                                Click="ShareCopyPathButton_Click">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.25"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M8.5,2 L12.5,5.5 L8.5,9 M12,5.5 H6.5 C4,5.5 2.5,7.2 2.5,9.5 M1.5,4.5 V12.5 H11.5 V10" />
                        </Button>

                        <!-- [🗑 删除] -->
                        <Button x:Name="DeleteButton"
                                Style="{StaticResource Win11CommandIconButtonStyle}"
                                IsEnabled="False"
                                ToolTip="删除 (Delete)"
                                Click="DeleteButton_Click">
                            <Path Width="13.5" Height="14" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.25"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M1,3 H12.5 M4.5,3 V1.4 H9 V3 M2.5,3 L3.2,12.8 H10.3 L11,3 M5.3,5.5 V10.5 M8.2,5.5 V10.5" />
                        </Button>

                        <Rectangle Width="1" Height="18" Fill="#DCE2EA" Margin="6,0" VerticalAlignment="Center" />

                        <!-- [⇅ 排序 ▾] -->
                        <Button x:Name="SortDropdownButton"
                                Style="{StaticResource Win11CommandButtonStyle}"
                                ToolTip="排序方式"
                                Click="SortDropdownButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="15" Height="14" Margin="0,0,5,0">
                                    <Path Stroke="#0067C0" StrokeThickness="1.35"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M3.8,12.5 V2 M1.2,4.8 L3.8,2 L6.4,4.8" />
                                    <Path Stroke="#475569" StrokeThickness="1.35"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M10.8,1.5 V12 M8.2,9.2 L10.8,12 L13.4,9.2" />
                                </Grid>
                                <TextBlock Text="排序" VerticalAlignment="Center" />
                                <Path Width="7" Height="4" Stretch="Uniform"
                                      Margin="5,1,0,0" VerticalAlignment="Center"
                                      Stroke="#475569" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M0.5,0.5 L3.5,3.5 L6.5,0.5" />
                            </StackPanel>
                        </Button>

                        <!-- [☰ 查看 ▾] -->
                        <Button x:Name="ViewDropdownButton"
                                Style="{StaticResource Win11CommandButtonStyle}"
                                ToolTip="视图模式与显示设置"
                                Click="ViewDropdownButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="14" Height="11" Stretch="Uniform"
                                      Margin="0,0,6,0" VerticalAlignment="Center"
                                      Stroke="#334155" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M0.5,1 H13.5 M0.5,5.5 H13.5 M0.5,10 H9.5" />
                                <TextBlock Text="查看" VerticalAlignment="Center" />
                                <Path Width="7" Height="4" Stretch="Uniform"
                                      Margin="5,1,0,0" VerticalAlignment="Center"
                                      Stroke="#475569" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M0.5,0.5 L3.5,3.5 L6.5,0.5" />
                            </StackPanel>
                        </Button>

                        <!-- [⋯ 更多] -->
                        <Button x:Name="MoreMenuButton"
                                Style="{StaticResource Win11CommandIconButtonStyle}"
                                Margin="2,0,0,0"
                                ToolTip="查看更多"
                                Click="MoreMenuButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="3" Height="3" Fill="#334155" Margin="1.5,0" />
                                <Ellipse Width="3" Height="3" Fill="#334155" Margin="1.5,0" />
                                <Ellipse Width="3" Height="3" Fill="#334155" Margin="1.5,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Rightmost: [◫ 预览] -->
                    <Button x:Name="PreviewPaneButton"
                            Grid.Column="1"
                            Style="{StaticResource Win11CommandButtonStyle}"
                            ToolTip="切换右侧预览窗格"
                            Click="PreviewPaneButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="15" Height="12.5" Margin="0,0,6,0">
                                <Rectangle Width="15" Height="12.5" RadiusX="1.8" RadiusY="1.8"
                                           Stroke="#334155" StrokeThickness="1.2" />
                                <Line X1="9.5" Y1="0.8" X2="9.5" Y2="11.7"
                                      Stroke="#0067C0" StrokeThickness="1.3" />
                            </Grid>
                            <TextBlock x:Name="PreviewPaneText" Text="预览" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== ROW 3: COLLAPSIBLE BOOKMARK BAR (Ctrl+Shift+B) ==================== -->
            <Border x:Name="BookmarkBarBorder"
                    Grid.Row="3"
                    Height="30"
                    Background="#FAFBFD"
                    BorderBrush="#E3E7EE"
                    BorderThickness="0,0,0,1"
                    Padding="10,0"
                    AllowDrop="True"
                    Visibility="Collapsed"
                    DragOver="BookmarkBar_DragOver"
                    Drop="BookmarkBar_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Height="23"
                            Padding="6,0"
                            Margin="0,0,6,0"
                            Style="{StaticResource Win11BreadcrumbButtonStyle}"
                            Foreground="#0067C0"
                            ToolTip="将当前目录加入书签栏 (也可直接拖入文件夹)"
                            Click="BookmarkStarButton_Click">
                        <TextBlock Text="+ 收藏当前" FontSize="11.5" />
                    </Button>

                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <ItemsControl x:Name="BookmarksItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="24"
                                            Padding="7,0"
                                            Margin="0,0,3,0"
                                            Tag="{Binding}"
                                            ToolTip="{Binding ToolTipText}"
                                            Style="{StaticResource Win11BreadcrumbButtonStyle}"
                                            Click="BookmarkItem_Click"
                                            MouseUp="BookmarkItem_MouseUp"
                                            MouseRightButtonUp="BookmarkItem_MouseRightButtonUp">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Width="14" Height="14"
                                                   Margin="0,0,5,0"
                                                   Source="{Binding Icon}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Title}"
                                                       MaxWidth="140"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ==================== ROW 4: PURE LIGHT NATIVE FILE VIEW SURFACE ==================== -->
            <Grid x:Name="BrowserStackGrid"
                  Grid.Row="4"
                  Background="#FFFFFF" />

            <!-- ==================== ROW 5: WIN11 FOOTER STATUS BAR ==================== -->
            <Border x:Name="BottomStatusBar"
                    Grid.Row="5"
                    Background="#F3F6FA"
                    BorderBrush="#E1E6EE"
                    BorderThickness="0,1,0,0"
                    Padding="12,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Bottom-Left: Item count + Selected count & total size -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLeftText"
                                   Text="就绪"
                                   FontSize="11.5"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusTransientText"
                                   Text=""
                                   FontSize="11.5"
                                   Foreground="#0067C0"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Bottom-Right: Win11 Segmented Quick View Switcher [ ☰ | ⊞ ] -->
                    <Border Grid.Column="1"
                            Height="21"
                            CornerRadius="3"
                            BorderBrush="#DCE2EA"
                            BorderThickness="1"
                            Background="#FAFBFD"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DetailsQuickButton"
                                    Width="26" Height="19" Padding="0"
                                    Style="{StaticResource Win11BreadcrumbButtonStyle}"
                                    ToolTip="详细信息视图"
                                    Click="DetailsViewButton_Click">
                                <Path x:Name="DetailsQuickGlyph"
                                      Width="11" Height="9" Stretch="Uniform"
                                      Stroke="#0067C0" StrokeThickness="1.25"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M0.5,1 H10.5 M0.5,4.5 H10.5 M0.5,8 H10.5" />
                            </Button>
                            <Rectangle Width="1" Height="13" Fill="#E1E6EE" VerticalAlignment="Center" />
                            <Button x:Name="IconsQuickButton"
                                    Width="26" Height="19" Padding="0"
                                    Style="{StaticResource Win11BreadcrumbButtonStyle}"
                                    ToolTip="大图标缩略图视图"
                                    Click="IconViewButton_Click">
                                <Path x:Name="IconsQuickGlyph"
                                      Width="10" Height="10" Stretch="Uniform"
                                      Stroke="#5A6577" StrokeThickness="1.2" StrokeLineJoin="Round"
                                      Data="M0.6,0.6 H4.2 V4.2 H0.6 Z M5.8,0.6 H9.4 V4.2 H5.8 Z M0.6,5.8 H4.2 V9.4 H0.6 Z M5.8,5.8 H9.4 V9.4 H5.8 Z" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
