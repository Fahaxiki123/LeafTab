                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- [✂ 剪切] -->
    <DrawingImage x:Key="IconCmdCut">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Brush="{StaticResource IcoGlassTintFill}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="6.5,17.5" RadiusX="2.8" RadiusY="2.8" />
                            <EllipseGeometry Center="17.5,17.5" RadiusX="2.8" RadiusY="2.8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M8.6,15.4 L18.5,4.5 M15.4,15.4 L5.5,4.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.65"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource IcoAccentBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,11.6" RadiusX="1.25" RadiusY="1.25" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- [❐ 复制] -->
    <DrawingImage x:Key="IconCmdCopy">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M5.8,16.5 H5.4 C4.3,16.5 3.6,15.7 3.6,14.6 V5.8 C3.6,4.5 4.6,3.5 5.9,3.5 H13.2 C14.3,3.5 15.1,4.1 15.3,5.1">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.65"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource IcoGlassTintFill}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8.5,6.5,10.5,13" RadiusX="2.4" RadiusY="2.4" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoAccentBrush}" Thickness="1.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- [📋 粘贴] -->
    <DrawingImage x:Key="IconCmdPaste">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Brush="{StaticResource IcoNeutralSoftFill}"
                                 Geometry="M8.5,5.2 H6.8 C5.7,5.2 4.8,6.1 4.8,7.2 V17.8 C4.8,19 5.7,20 6.9,20 H17.1 C18.3,20 19.2,19 19.2,17.8 V7.2 C19.2,6.1 18.3,5.2 17.2,5.2 H15.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.6"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E6F2FF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8.5,3.2,7,3.8" RadiusX="1.5" RadiusY="1.5" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoAccentBrush}" Thickness="1.55" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M8.8,11.4 H15.2 M8.8,15 H13.2">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoAccentBrush}" Thickness="1.55"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

