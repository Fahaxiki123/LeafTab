    <!-- [↪ 复制路径] -->
    <DrawingImage x:Key="IconCmdCopyPath">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M18.5,14.2 V17.2 C18.5,18.5 17.5,19.5 16.2,19.5 H6.3 C5,19.5 4,18.5 4,17.2 V7.8 C4,6.5 5,5.5 6.3,5.5 H9.5">
                    <GeometryDrawing.Pen>
