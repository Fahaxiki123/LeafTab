                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoAccentBrush}" Thickness="1.65" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M12,8.2 V15.8 M8.2,12 H15.8">
                    <GeometryDrawing.Pen>
