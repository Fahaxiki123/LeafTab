                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.6" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M4.2,7 H19.8 M9.2,7 V5.2 C9.2,4.4 9.8,3.8 10.6,3.8 H13.4 C14.2,3.8 14.8,4.4 14.8,5.2 V7">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.6"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M10.2,10.8 V16.4 M13.8,10.8 V16.4">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoMutedBrush}" Thickness="1.5"
