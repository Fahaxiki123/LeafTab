                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M7.2,14.5 L9.5,9.2 L11.8,14.5 M7.9,13.1 H11.1">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.5"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
