<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== SF SYMBOLS DUAL-TONE PALETTE ==================== -->
    <SolidColorBrush x:Key="IcoPrimaryBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="IcoSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="IcoMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="IcoAccentBrush" Color="#007AFF" />
    <SolidColorBrush x:Key="IcoAccentDeepBrush" Color="#0062CC" />
    <SolidColorBrush x:Key="IcoGlassTintFill" Color="#24007AFF" />
    <SolidColorBrush x:Key="IcoGlassStrongFill" Color="#30007AFF" />
    <SolidColorBrush x:Key="IcoNeutralSoftFill" Color="#0D0F172A" />

    <!-- ==================== ROW 1: NAVIGATION ICONS (24x24 Grid) ==================== -->
    <DrawingImage x:Key="IconNavBack">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M19,12 H5.5 M11.2,6.4 L5.2,12 L11.2,17.6">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.75"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="IconNavForward">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M5,12 H18.5 M12.8,6.4 L18.8,12 L12.8,17.6">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.75"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="IconNavUp">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M12,19 V5.5 M6.4,11.2 L12,5.2 L17.6,11.2">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.75"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="IconNavRefresh">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M19.4,12.2 A7.4,7.4 0 1 1 17.2,6.8 L19.7,9.2 M19.7,4.8 V9.2 H15.3">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.75"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ==================== ADDRESS & SEARCH DUAL-TONE ICONS ==================== -->
    <DrawingImage x:Key="IconAddressComputer">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Brush="{StaticResource IcoGlassTintFill}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,4,18,12.5" RadiusX="2.5" RadiusY="2.5" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.65" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M8.5,20 H15.5 M12,16.5 V20">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoAccentBrush}" Thickness="1.7"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="IconSearchMagnifier">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Brush="{StaticResource IcoGlassTintFill}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="10.8,10.8" RadiusX="6.5" RadiusY="6.5" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoPrimaryBrush}" Thickness="1.65" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M15.6,15.6 L20,20">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoAccentBrush}" Thickness="1.85"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ==================== ROW 2: SF SYMBOLS DUAL-TONE COMMAND BAR ICONS ==================== -->
