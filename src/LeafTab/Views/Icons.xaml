                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M15.2,4.5 L20,9.2 L15.2,13.9 M19.5,9.2 H13.2 C10.2,9.2 8.5,11 8.5,14">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IcoAccentBrush}" Thickness="1.7"
