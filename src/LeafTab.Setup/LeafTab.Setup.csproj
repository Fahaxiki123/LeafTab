<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\LeafTab\Assets\LeafTab.ico</ApplicationIcon>
    <AssemblyName>LeafTab-v0.6.10-Setup-x64</AssemblyName>
    <RootNamespace>LeafTab.Setup</RootNamespace>
    <Version>0.6.10</Version>
    <AssemblyTitle>LeafTab（一叶）v0.6.10 安装向导</AssemblyTitle>
    <Product>LeafTab（一叶）</Product>
    <Company>LeafTab</Company>
    <Copyright>Copyright © LeafTab</Copyright>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeafTab\LeafTab.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <UsingTask TaskName="PackLeafTabPayloadTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceExePath ParameterType="System.String" Required="true" />
      <OutputGzPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string srcPath = SourceExePath;
        if (!File.Exists(srcPath))
        {
            Log.LogError("LeafTab.exe build output not found at '{0}'.", srcPath);
            return false;
        }

        string outDir = Path.GetDirectoryName(OutputGzPath);
        if (!string.IsNullOrEmpty(outDir))
        {
            Directory.CreateDirectory(outDir);
        }

        byte[] rawBytes = File.ReadAllBytes(srcPath);
        using (var fs = new FileStream(OutputGzPath, FileMode.Create, FileAccess.Write, FileShare.None))
        using (var gz = new GZipStream(fs, CompressionLevel.Optimal, leaveOpen: false))
        {
            gz.Write(rawBytes, 0, rawBytes.Length);
        }
        using (var sha = System.Security.Cryptography.SHA256.Create())
        {
            File.WriteAllText(OutputGzPath + ".sha256", BitConverter.ToString(sha.ComputeHash(rawBytes)).Replace("-", "").ToLowerInvariant());
        }

        Log.LogMessage(MessageImportance.High, "Packed LeafTab.exe ({0} bytes -> {1} bytes GZip)", rawBytes.Length, new FileInfo(OutputGzPath).Length);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PackLeafTabPayload" BeforeTargets="BeforeResGen;PrepareResources;MarkupCompilePass1"
          DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="..\LeafTab\LeafTab.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_LeafTabBuildOutput" />
    </MSBuild>
    <PropertyGroup>
      <_PackedPayloadPath>$(IntermediateOutputPath)LeafTab.Payload.gz</_PackedPayloadPath>
    </PropertyGroup>

    <PackLeafTabPayloadTask SourceExePath="@(_LeafTabBuildOutput)"
                            OutputGzPath="$(_PackedPayloadPath)" />

    <ItemGroup>
      <EmbeddedResource Include="$(_PackedPayloadPath)">
        <LogicalName>LeafTab.Payload.gz</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(_PackedPayloadPath).sha256">
        <LogicalName>LeafTab.Payload.sha256</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
