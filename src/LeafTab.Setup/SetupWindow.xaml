<Window x:Class="LeafTab.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LeafTab（一叶）安装向导"
        Width="548"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F8FB"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryGlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0066D6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0052AD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Frosted Button Style -->
        <Style x:Key="SecondaryGlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#240F172A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption Close Button -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Rounded CheckBox Style -->
        <Style x:Key="LiquidCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Box"
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    Margin="0,1,10,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="5"
                                    Background="#FFFFFF"
                                    BorderBrush="#380F172A"
                                    BorderThickness="1.2">
                                <Path x:Name="CheckMark"
                                      Width="10" Height="8"
                                      Stretch="Uniform"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      Data="M1,4.2 L3.8,7 L9.2,1" />
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#007AFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#007AFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#007AFF" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1F0F172A" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F8FBFE" Offset="0.0" />
                <GradientStop Color="#EEF4F9" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Subtle Window Titlebar -->
            <Grid Grid.Row="0" Margin="14,4,8,0">
                <TextBlock x:Name="WindowBadgeText"
                           Text="LeafTab Setup"
                           FontSize="11.5"
                           Foreground="#64748B"
                           VerticalAlignment="Center" />

                <Button x:Name="TopCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionCloseBtnStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="关闭"
                        Click="CancelOrClose_Click">
                    <Path Width="9.5" Height="9.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.35"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M0.5,0.5 L9,9 M9,0.5 L0.5,9" />
                </Button>
            </Grid>

            <!-- Row 1: Brand Hero Header -->
            <Grid Grid.Row="1" Margin="24,6,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="52" Height="52"
                        CornerRadius="14"
                        Background="#FFFFFF"
                        BorderBrush="#2215803D"
                        BorderThickness="1"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="2" Opacity="0.07" />
                    </Border.Effect>
                    <Path Width="29" Height="29" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22C55E" Offset="0.0" />
                                <GradientStop Color="#15803D" Offset="1.0" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitleText"
                                   Text="安装 LeafTab（一叶）"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <Border Background="#1616A34A"
                                CornerRadius="6"
                                Padding="7,2"
                                Margin="9,2,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="v0.6.6 · x64"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#15803D" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="HeroSubtitleText"
                               Text="轻量级、零注入、原生极速 Windows 多标签资源管理器"
                               FontSize="12.5"
                               Foreground="#64748B"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Row 2: Main Configuration / Uninstall / Progress Card -->
            <Grid Grid.Row="2" Margin="24,0,24,14">
                <!-- INSTALL OPTIONS PANEL -->
                <StackPanel x:Name="InstallConfigPanel">
                    <!-- Install Path Card -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#180F172A"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="15,12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="安装位置"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"
                                       Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="#F8FAFC"
                                        BorderBrush="#220F172A"
                                        BorderThickness="1"
                                        CornerRadius="7.5"
                                        Padding="9,6">
                                    <TextBox x:Name="InstallPathTextBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#0F172A"
                                             FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             TextChanged="InstallPathTextBox_TextChanged" />
                                </Border>
                                <Button Grid.Column="1"
                                        Content="浏览…"
                                        Margin="8,0,0,0"
                                        Padding="14,6.5"
                                        Style="{StaticResource SecondaryGlassButtonStyle}"
                                        Click="BrowseFolder_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Checkboxes Card -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#180F172A"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="16,12">
                        <StackPanel>
                            <CheckBox x:Name="SetDefaultCheckBox"
                                      Style="{StaticResource LiquidCheckBoxStyle}"
                                      IsChecked="True">
                                <StackPanel>
                                    <TextBlock Text="设为默认资源管理器（推荐）" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <TextBlock Text="打开桌面/任意文件夹与按 Win+E 时自动使用 LeafTab，随时可在软件 ⋯ 菜单一键恢复系统默认"
                                               FontSize="11.5"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox x:Name="ContextMenuCheckBox"
                                      Style="{StaticResource LiquidCheckBoxStyle}"
                                      IsChecked="True"
                                      Content="添加文件夹与磁盘右键菜单「在 LeafTab 中打开」" />

                            <CheckBox x:Name="ShortcutsCheckBox"
                                      Style="{StaticResource LiquidCheckBoxStyle}"
                                      IsChecked="True"
                                      Content="创建桌面与开始菜单快捷方式" />

                            <CheckBox x:Name="LaunchNowCheckBox"
                                      Style="{StaticResource LiquidCheckBoxStyle}"
                                      IsChecked="True"
                                      Content="安装完成后立即启动 LeafTab" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- UNINSTALL OPTIONS PANEL -->
                <Border x:Name="UninstallConfigPanel"
                        Visibility="Collapsed"
                        Background="#FFFFFF"
                        BorderBrush="#180F172A"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="卸载程序将自动恢复 Windows 默认文件夹与 Win+E 打开方式，并移除桌面与开始菜单快捷方式。"
                                   FontSize="13"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />

                        <TextBlock x:Name="UninstallLocationText"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,8,0,12"
                                   TextTrimming="CharacterEllipsis" />

                        <CheckBox x:Name="RemoveUserDataCheckBox"
                                  Style="{StaticResource LiquidCheckBoxStyle}"
                                  IsChecked="False"
                                  Content="同时删除个人收藏书签与界面配置文件" />
                    </StackPanel>
                </Border>

                <!-- PROGRESS & STATUS PANEL -->
                <Border x:Name="ProgressCardPanel"
                        Visibility="Collapsed"
                        Background="#FFFFFF"
                        BorderBrush="#180F172A"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="18,22">
                    <StackPanel>
                        <TextBlock x:Name="StatusStepText"
                                   Text="正在准备安装…"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap" />

                        <ProgressBar x:Name="SetupProgressBar"
                                     Height="7"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Foreground="#007AFF"
                                     Background="#E2E8F0"
                                     BorderThickness="0" />

                        <TextBlock x:Name="StatusDetailText"
                                   Text="纯用户态配置，无需管理员权限，不会向系统目录写入任何注入组件。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: Footer Bar -->
            <Border Grid.Row="3"
                    Background="#99FFFFFF"
                    BorderBrush="#140F172A"
                    BorderThickness="0,1,0,0"
                    Padding="24,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterHintText"
                               Grid.Column="0"
                               Text="纯用户态免管理员权限 · 支持系统设置一键卸载"
                               FontSize="11.5"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton"
                                Content="取消"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryGlassButtonStyle}"
                                Click="CancelOrClose_Click" />

                        <Button x:Name="PrimaryActionButton"
                                Content="立即安装"
                                Style="{StaticResource PrimaryGlassButtonStyle}"
                                Click="PrimaryActionButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
